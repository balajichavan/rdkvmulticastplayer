{
  "locations": [
    {
      "callsign": "org.rdk.MulticastPlayer",
      "locator": "libWPEFrameworkMulticastPlayer.so",
      "classname": "MulticastPlayer",
      "autostart": false,
      "configuration": {
        "interface": "eth0",
        "defaulttransport": "udp",
        "videoDecoder": "avdec_h264",
        "audioDecoder": "avdec_aac",
        "videoSink": "autovideosink"
      }
    }
  ]
}
