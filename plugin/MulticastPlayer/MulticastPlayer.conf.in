# MulticastPlayer.config - Thunder plugin instantiation config
#
# Consumed by write_config() during the CMake build to emit the plugin's
# .json config that Thunder loads at boot.

#set(autostart false)
#set(preconditions Platform)
#set(callsign "org.rdk.MulticastPlayer")

#map()
#    kv(interface "eth0")
#    kv(defaulttransport "udp")
    # Element overrides. Leave empty for automatic platform detection
    # (Broadcom STB -> Raspberry Pi V4L2 -> generic/software emulator).
    # Emulator example: videoDecoder=avdec_h264, videoSink=autovideosink.
#    kv(videoDecoder "")
#    kv(audioDecoder "")
#    kv(videoSink "")
#end()
#ans(configuration)
precondition = ["Platform"]
callsign = "org.rdk.MulticastPlayer"
autostart = False

configuration = {
    "interface": "eth0",
    "defaulttransport": "udp",
    "videoDecoder": "",
    "audioDecoder": "",
    "videoSink": ""
}
