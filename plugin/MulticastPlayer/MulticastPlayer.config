# MulticastPlayer.config - Thunder plugin instantiation config
#
# Consumed by write_config() during the CMake build to emit the plugin's
# .json config that Thunder loads at boot.

set(autostart false)
set(preconditions Platform)
set(callsign "org.rdk.MulticastPlayer")

map()
    kv(interface "eth0")
    kv(defaulttransport "udp")
end()
ans(configuration)
